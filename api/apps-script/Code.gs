/** i-TEK Live PM Portal - Google Apps Script backend. Deploy as web app: execute as owner, access anyone. */
const TABS = {
 Users:['email','name','role','zone','active','createdAt','username','passwordSalt','passwordHash','mustChangePassword','failedAttempts','lockedUntil'],
 Stores:['code','name','zone','state','city','address','pincode','assignedEngineer','createdAt','createdBy'],
 Visits:['id','storeCode','zone','visitType','engineerEmail','engineerName','createdAt','updatedAt','status','remarks','damaged','damageNote','clientTokenHash','clientExpiresAt','clientName','clientStars','clientFeedback','clientDecidedAt','emails','phones','revision','syncId','ticketId','ticketStatus'],
 Devices:['id','visitId','type','subtype','serial','ip','rposIp','mac','imei','amc','activity','remarks','imageIds'],
 Spares:['id','visitId','deviceId','name','otherText'],
 Notifications:['id','createdAt','zone','recipient','kind','visitId','message','status'],
 Audit:['id','at','actor','action','recordId','detail'],
 Sessions:['sessionHash','username','expiresAt','createdAt'],
 AMC:['serial'],
};
const ZONES=['North','South','East','West'];
const ROSTER={
 'North':{rm:'Pravin Patil',engineers:['Mrityunjay Srivastav','Nitesh Mishra','Asgar Ali','Afzal Ahmad','Priyanshu Mahawar','Balram','Diwakar Singh','Saurabh Singh','Shivam Tiwari']},
 'South':{rm:'Sachin Shinde',engineers:['Sarathy R','Anand Kumar','Sakthi S','Arun Kumar','Ganesh Merugu','Adarsh Shukla','Aravind Avula','Kartik Naikodi','Sarath Kumar']},
 'East':{rm:'Basudeb Roy',engineers:['Rabindranath Samanta','Kartik Barman','Romesh Bhattacharya','Subham Sarkar','Chaman Raj','Om Prakash','Sonu Shankar','Sk Abdul Rakib','Rohit Mondal']},
 'West':{rm:'Sandip Suryawanshi',engineers:['Sagar Bait','Swapnil Chaudhary','Vipin Mishra','Suyog Nagarare','Vijay Mandave','Amit Kumar']}
};
function cfg_(key){return PropertiesService.getScriptProperties().getProperty(key)||'';}
function ss_(){const id=cfg_('SPREADSHEET_ID');if(!id)throw Error('Set SPREADSHEET_ID in Script Properties');return SpreadsheetApp.openById(id);}
function sheet_(name){const s=ss_().getSheetByName(name);if(!s)throw Error('Missing sheet '+name+'; run setupDatabase');return s;}
function setupDatabase(){const ss=ss_();Object.keys(TABS).forEach(name=>{let s=ss.getSheetByName(name);if(!s)s=ss.insertSheet(name);if(s.getLastRow()===0){s.appendRow(TABS[name]);s.setFrozenRows(1);s.getRange(1,1,1,TABS[name].length).setBackground('#171717').setFontColor('#F5A623').setFontWeight('bold');}});return 'Database initialized. Import StoreSeed.csv and AMCSeed.csv into their matching sheets.';}
function all_(name){const s=sheet_(name),v=s.getDataRange().getDisplayValues();if(v.length<2)return [];const headers=TABS[name];return v.slice(1).filter(r=>r.some(x=>x!=='')).map((r,i)=>Object.assign({__row:i+2},Object.fromEntries(headers.map((h,j)=>[h,r[j]||'']))));}
function findBy_(name,column,value){const sh=sheet_(name),idx=TABS[name].indexOf(column);if(idx<0)throw Error('Unknown column '+column);if(sh.getLastRow()<2)return null;const cell=sh.getRange(2,idx+1,sh.getLastRow()-1,1).createTextFinder(String(value)).matchEntireCell(true).matchCase(false).findNext();if(!cell)return null;const row=cell.getRow(),values=sh.getRange(row,1,1,TABS[name].length).getDisplayValues()[0];return Object.assign({__row:row},Object.fromEntries(TABS[name].map((h,j)=>[h,values[j]||''])))}
function amcLookup_(serial){return !!findBy_('AMC','serial',serial)}
function append_(name,rows){if(!rows.length)return;const s=sheet_(name);s.getRange(s.getLastRow()+1,1,rows.length,TABS[name].length).setValues(rows.map(o=>TABS[name].map(h=>{let v=o[h];return v==null?'':typeof v==='object'?JSON.stringify(v):String(v);})));}
function update_(name,row,obj){sheet_(name).getRange(row,1,1,TABS[name].length).setValues([TABS[name].map(h=>{const v=obj[h];return v==null?'':typeof v==='object'?JSON.stringify(v):String(v);})]);}
function uid_(){return Utilities.getUuid();}
function now_(){return new Date().toISOString();}
function safe_(s,max=5000){return String(s??'').trim().slice(0,max).replace(/^[=+@\-\t\r]/,'\u0027$&');}
function tokenHash_(t){return Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,t)).replace(/=+$/,'');}
function hashPassword_(password,salt){let bytes=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,salt+'|'+password);for(let i=0;i<12000;i++)bytes=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,bytes);return Utilities.base64EncodeWebSafe(bytes).replace(/=+$/,'');}
function randomSecret_(){return Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'');}
function passwordOk_(password){if(typeof password!=='string'||password.length<12||password.length>128||!/[A-Z]/.test(password)||!/[a-z]/.test(password)||!/[0-9]/.test(password)||!/[^A-Za-z0-9]/.test(password))throw Error('Password must be 12–128 characters and include upper/lowercase letters, a number and a symbol.');}
function username_(name){return String(name||'').trim().toLowerCase().replace(/[^a-z0-9._-]/g,'');}
function authUser_(username){return all_('Users').find(u=>u.username===username&&u.active==='Yes');}
function createSession_(user){const secret=randomSecret_(),record={sessionHash:tokenHash_(secret),username:user.username,expiresAt:new Date(Date.now()+8*3600000).toISOString(),createdAt:now_()};append_('Sessions',[record]);return secret;}
function login_(p){const username=username_(p.username),lock=LockService.getScriptLock();lock.waitLock(20000);try{const u=authUser_(username);if(!u||!u.passwordHash)throw Error('Invalid username or password');if(Date.parse(u.lockedUntil||'')>Date.now())throw Error('Account temporarily locked. Try again later or contact your manager.');const valid=hashPassword_(String(p.password||''),u.passwordSalt)===u.passwordHash;if(!valid){u.failedAttempts=String(Number(u.failedAttempts||0)+1);if(Number(u.failedAttempts)>=5){u.lockedUntil=new Date(Date.now()+15*60000).toISOString();u.failedAttempts='0';}update_('Users',u.__row,u);throw Error('Invalid username or password');}u.failedAttempts='0';u.lockedUntil='';update_('Users',u.__row,u);const session=createSession_(u);audit_(u.username,'LOGIN',u.username,{});return {session,mustChangePassword:u.mustChangePassword==='Yes'};}finally{lock.releaseLock();}}
function checkIdentity_(token){if(!token)throw Error('Sign in required');const h=tokenHash_(String(token)),session=all_('Sessions').find(x=>x.sessionHash===h);if(!session||Date.parse(session.expiresAt)<Date.now())throw Error('Session expired. Sign in again.');const user=authUser_(session.username);if(!user)throw Error('Account disabled');return user;}
function changePassword_(token,p){const u=checkIdentity_(token);passwordOk_(p.newPassword);if(!u.mustChangePassword||u.mustChangePassword!=='Yes'){if(hashPassword_(String(p.oldPassword||''),u.passwordSalt)!==u.passwordHash)throw Error('Current password incorrect');}const salt=randomSecret_();u.passwordSalt=salt;u.passwordHash=hashPassword_(p.newPassword,salt);u.mustChangePassword='No';update_('Users',u.__row,u);audit_(u.username,'PASSWORD_CHANGED',u.username,{});return {ok:true};}
function logout_(token){const hash=tokenHash_(String(token||''));all_('Sessions').filter(x=>x.sessionHash===hash).sort((a,b)=>b.__row-a.__row).forEach(x=>sheet_('Sessions').deleteRow(x.__row));return {ok:true};}
function provisionInitialHod(){const username=username_(cfg_('INITIAL_HOD_USERNAME')||'bhupesh.mistry'),email=String(cfg_('INITIAL_HOD_EMAIL')||'').toLowerCase(),pass=cfg_('INITIAL_HOD_TEMP_PASSWORD');if(!email||!pass)throw Error('Set INITIAL_HOD_EMAIL and INITIAL_HOD_TEMP_PASSWORD in Script Properties');passwordOk_(pass);const lock=LockService.getScriptLock();lock.waitLock(20000);try{if(all_('Users').some(x=>x.role==='HOD'&&x.passwordHash))throw Error('HOD already provisioned. Refusing to reset automatically.');let u=all_('Users').find(x=>x.username===username||x.email.toLowerCase()===email);const salt=randomSecret_();const record={email,name:'Bhupesh Mistry',role:'HOD',zone:'',active:'Yes',createdAt:u?.createdAt||now_(),username,passwordSalt:salt,passwordHash:hashPassword_(pass,salt),mustChangePassword:'Yes',failedAttempts:'0',lockedUntil:''};if(u)update_('Users',u.__row,record);else append_('Users',[record]);audit_('SYSTEM','INITIAL_HOD',username,{});return 'Initial HOD created. Remove INITIAL_HOD_TEMP_PASSWORD from Script Properties after first login.';}finally{lock.releaseLock();}}
function resetPassword_(actor,p){requireManager_(actor);const target=all_('Users').find(x=>x.username===username_(p.username));if(!target)throw Error('User not found');if(target.role==='HOD')throw Error('HOD password reset requires separate owner recovery');if(actor.role==='RM'&&(target.role!=='Engineer'||target.zone!==actor.zone))throw Error('Not authorized');const password=randomSecret_().slice(0,14)+'aA1!';const salt=randomSecret_();target.passwordSalt=salt;target.passwordHash=hashPassword_(password,salt);target.mustChangePassword='Yes';target.failedAttempts='0';target.lockedUntil='';update_('Users',target.__row,target);audit_(actor.username,'PASSWORD_RESET',target.username,{});return {username:target.username,temporaryPassword:password};}
function authorize_(user,zone){if(user.role==='HOD')return;if(zone!==user.zone)throw Error('Access denied: different zone');}
function requireManager_(u){if(!['HOD','RM'].includes(u.role))throw Error('Manager access required');}
function audit_(actor,action,id,detail){append_('Audit',[{id:uid_(),at:now_(),actor,action,recordId:id,detail:JSON.stringify(detail||{}).slice(0,3000)}]);}
function notify_(zone,kind,visitId,message){const users=all_('Users').filter(u=>u.active==='Yes'&&(u.role==='RM'&&u.zone===zone));append_('Notifications',users.map(u=>({id:uid_(),createdAt:now_(),zone,recipient:u.email,kind,visitId,message,status:'Queued'})));users.forEach(u=>{try{MailApp.sendEmail({to:u.email,subject:'[i-TEK] '+kind,body:message});}catch(e){console.warn('Email not sent: '+e);}});}
function doGet(e){const t=HtmlService.createTemplateFromFile('Index');t.appUrl=ScriptApp.getService().getUrl();return t.evaluate().setTitle('i-TEK | PM Sign-off Portal').addMetaTag('viewport','width=device-width,initial-scale=1');}
function include(name){return HtmlService.createHtmlOutputFromFile(name).getContent();}
function api(idToken,action,payload){payload=payload||{};if(action==='login')return login_(payload);if(action==='changePassword')return changePassword_(idToken,payload);if(action==='logout')return logout_(idToken);if(action==='clientRead')return clientRead_(payload.token);if(action==='clientDecision')return clientDecision_(payload);const user=checkIdentity_(idToken);if(user.mustChangePassword==='Yes')throw Error('Password change required');switch(action){
 case 'dashboardScope':return {email:user.email,role:user.role,zone:user.zone};
 case 'bootstrap':return bootstrap_(user);
 case 'list':return list_(user,payload);
 case 'saveVisit':return saveVisit_(user,payload);
 case 'registerStore':return registerStore_(user,payload);
 case 'assign':return assign_(user,payload);
 case 'createUser':return createUser_(user,payload);
 case 'importHistory':return importHistory_(user,payload);
 case 'suggestSerial':return suggestSerial_(user,payload);
 case 'resetPassword':return resetPassword_(user,payload);
 case 'uploadImage':return uploadImage_(user,payload);
 case 'newApprovalLink':return newApprovalLink_(user,payload);
 case 'getVisit':return getVisit_(user,payload.id);
 case 'notifications':return all_('Notifications').filter(n=>n.recipient===user.email).slice(-60).reverse();
 default:throw Error('Unknown action');}}
function bootstrap_(u){return {me:{email:u.email,username:u.username,name:u.name,role:u.role,zone:u.zone},zones:ZONES,roster:ROSTER,stores:all_('Stores').filter(s=>u.role==='HOD'||s.zone===u.zone).map(({__row,...s})=>s),users:all_('Users').filter(x=>u.role==='HOD'||x.zone===u.zone).map(({__row,...x})=>({email:x.email,username:x.username,name:x.name,role:x.role,zone:x.zone,active:x.active})),visits:visibleVisits_(u).map(v=>summary_(v))};}
function visibleVisits_(u){return all_('Visits').filter(v=>u.role==='HOD'||(u.role==='RM'&&v.zone===u.zone)||(u.role==='Engineer'&&v.engineerEmail===u.email));}
function summary_(v){const {clientTokenHash,__row,...data}=v;return data;}
function list_(u,p){return {visits:visibleVisits_(u).map(summary_),stores:all_('Stores').filter(s=>u.role==='HOD'||s.zone===u.zone).map(({__row,...s})=>s)};}
function registerStore_(u,p){const code=safe_(p.code,40).toUpperCase(),zone=safe_(p.zone,12);if(!code||!ZONES.includes(zone))throw Error('Store code and valid zone required');authorize_(u,zone);const lock=LockService.getScriptLock();lock.waitLock(20000);try{const exists=all_('Stores').find(s=>s.code===code);if(exists)throw Error('Store already exists');const record={code,name:safe_(p.name,100),zone,state:safe_(p.state,80),city:safe_(p.city,80),address:safe_(p.address,500),pincode:safe_(p.pincode,10),assignedEngineer:u.role==='Engineer'?u.email:'',createdAt:now_(),createdBy:u.email};append_('Stores',[record]);audit_(u.email,'STORE_CREATED',code,record);notify_(zone,'New Store Registered',code,`${u.name} registered new store ${code} (${zone}).`);return record;}finally{lock.releaseLock();}}
function assign_(u,p){requireManager_(u);const code=safe_(p.code,40).toUpperCase(),store=all_('Stores').find(s=>s.code===code);if(!store)throw Error('Store not found');authorize_(u,store.zone);const eng=all_('Users').find(x=>x.email===String(p.engineerEmail||'').toLowerCase()&&x.role==='Engineer'&&x.active==='Yes'&&x.zone===store.zone);if(!eng)throw Error('Engineer not found in zone');store.assignedEngineer=eng.email;update_('Stores',store.__row,store);audit_(u.email,'ASSIGNED',code,{engineer:eng.email});return {ok:true};}
function createUser_(u,p){requireManager_(u);const createLock=LockService.getScriptLock();createLock.waitLock(20000);try{const role=safe_(p.role,12),zone=safe_(p.zone,12),email=safe_(p.email,200).toLowerCase(),username=username_(p.username);if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)||!['Engineer','RM'].includes(role))throw Error('Invalid email/role');if(!/^[a-z0-9][a-z0-9._-]{3,39}$/.test(username))throw Error('Username must be 4–40 lowercase characters');if(role==='RM'&&u.role!=='HOD')throw Error('Only HOD can create RMs');if(!ZONES.includes(zone))throw Error('Invalid zone');authorize_(u,zone);if(all_('Users').some(x=>String(x.email||'').trim().toLowerCase()===email||username_(x.username)===username||String(x.name||'').trim().toLowerCase()===safe_(p.name,120).trim().toLowerCase()))throw Error('An account with this email, username or full name already exists');const password=randomSecret_().slice(0,14)+'aA1!',salt=randomSecret_();append_('Users',[{email,name:safe_(p.name,120),role,zone,active:'Yes',createdAt:now_(),username,passwordSalt:salt,passwordHash:hashPassword_(password,salt),mustChangePassword:'Yes',failedAttempts:'0',lockedUntil:''}]);audit_(u.username,'USER_CREATED',username,{role,zone});return {username,temporaryPassword:password};}finally{createLock.releaseLock();}}
function importHistory_(u,p){requireManager_(u);const rows=p.rows;if(!Array.isArray(rows)||!rows.length||rows.length>500)throw Error('Import 1–500 detail rows per batch');const grouped={};rows.forEach(r=>{const id=safe_(r.ID,100),code=safe_(r.StoreCode,40).toUpperCase(),zone=safe_(r.Zone,20);if(!id||!code||!ZONES.includes(zone))throw Error('Each row needs ID, StoreCode and Zone');authorize_(u,zone);if(!grouped[id])grouped[id]={id,code,zone,rows:[]};if(grouped[id].code!==code)throw Error('Visit ID belongs to multiple stores');grouped[id].rows.push(r)});const lock=LockService.getScriptLock();lock.waitLock(25000);try{let added=0,skipped=0;const existing=new Set(all_('Visits').map(v=>v.id));const storeMap=new Map(all_('Stores').map(st=>[st.code,st]));Object.values(grouped).forEach(g=>{if(existing.has(g.id)){skipped++;return;}const r=g.rows[0],ts=now_();if(!storeMap.has(g.code)){const st={code:g.code,name:'',zone:g.zone,state:safe_(r.State,80),city:'',address:safe_(r.Address,500),pincode:safe_(r.Pincode,10),assignedEngineer:'',createdAt:ts,createdBy:u.email};append_('Stores',[st]);storeMap.set(g.code,st);}const allowed=['Draft','Pending Client','Completed','Rejected'];const status=allowed.includes(r.Status)?r.Status:'Draft';const v={id:g.id,storeCode:g.code,zone:g.zone,visitType:safe_(r.VisitType,50)||'PM Visit',engineerEmail:'',engineerName:safe_(r.Engineer,120),createdAt:safe_(r.Created,40)||ts,updatedAt:safe_(r.Updated,40)||ts,status,remarks:safe_(r.OverallRemarks,5000),damaged:'No',damageNote:'',clientTokenHash:'',clientExpiresAt:'',clientName:'',clientStars:safe_(r.ClientStars,5),clientFeedback:safe_(r.ClientFeedback,2000),clientDecidedAt:'',emails:JSON.stringify(String(r.Emails||'').split(';').map(x=>x.trim()).filter(Boolean).slice(0,3)),phones:JSON.stringify(String(r.Phones||'').split(';').map(x=>x.trim()).filter(Boolean).slice(0,3)),revision:'1',syncId:'IMPORT-'+g.id,ticketId:'',ticketStatus:''};append_('Visits',[v]);const devices=g.rows.filter(x=>x.DeviceType).map(x=>({id:uid_(),visitId:g.id,type:safe_(x.DeviceType,80),subtype:safe_(x.SubType,80),serial:safe_(x.Serial,120),ip:safe_(x.IP,50),rposIp:'',mac:'',imei:'',amc:x.UnderAMC==='Yes'?'Yes':'No',activity:safe_(x.Activity,3000),remarks:safe_(x.DeviceRemarks,3000),imageIds:'[]'}));append_('Devices',devices);const spareRows=[];devices.forEach((d,i)=>{String(g.rows.filter(x=>x.DeviceType)[i].Spares||'').split(',').map(x=>x.trim()).filter(Boolean).forEach(x=>spareRows.push({id:uid_(),visitId:g.id,deviceId:d.id,name:safe_(x.replace(/×.*$/,'').trim(),100),otherText:''}))});append_('Spares',spareRows);existing.add(g.id);added++});audit_(u.email,'HISTORY_IMPORT','batch',{added,skipped});return {added,skipped};}finally{lock.releaseLock();}}
function suggestSerial_(u,p){const serial=safe_(p.serial,120).trim().toUpperCase();if(serial.length<5)return [];const prefix=serial.slice(0,Math.min(8,serial.length));const matches=[];all_('AMC').forEach(x=>{const value=String(x.serial||'').trim().toUpperCase();if(value!==serial&&value.startsWith(prefix)&&matches.length<6)matches.push(value)});return matches;}
function validateVisit_(u,p){const s=findBy_('Stores','code',String(p.storeCode||'').toUpperCase());if(!s)throw Error('Register store before visit');authorize_(u,s.zone);if(u.role==='Engineer'&&s.assignedEngineer&&s.assignedEngineer!==u.email)throw Error('Store assigned to another engineer');if(!['PM Visit','Regular Store Visit'].includes(p.visitType))throw Error('Visit type required');if(!Array.isArray(p.devices)||!p.devices.length)throw Error('Add at least one device');if((p.emails||[]).length>3||(p.phones||[]).length>3)throw Error('Maximum three contacts');const seen=new Set();p.devices.forEach((d,i)=>{if(!['i-TEK Shell','i-TEK Pay device','i-TEK Reader','i-TEK Tunnel'].includes(d.type)||!d.subtype||!d.serial||!d.ip)throw Error('Device '+(i+1)+' missing mandatory fields');if(!/^(\d{1,3}\.){3}\d{1,3}$/.test(d.ip)||d.ip.split('.').some(n=>Number(n)>255))throw Error('Invalid device IP');if(d.rposIp&&d.type!=='i-TEK Pay device')throw Error('RPOS IP only for Pay device');if(d.rposIp&&(!/^(\d{1,3}\.){3}\d{1,3}$/.test(d.rposIp)||d.rposIp.split('.').some(n=>Number(n)>255)))throw Error('Invalid RPOS IP');if(seen.has(d.serial.toUpperCase()))throw Error('Duplicate serial in visit');seen.add(d.serial.toUpperCase());if((d.imageIds||[]).length>2)throw Error('Maximum 2 images per device');});return s;}
function saveVisit_(u,p){if(u.role!=='Engineer'&&u.role!=='HOD')throw Error('Engineer access required');const store=validateVisit_(u,p);const lock=LockService.getScriptLock();lock.waitLock(25000);try{const id=safe_(p.id,80)||uid_(),syncId=safe_(p.syncId,100)||id,old=all_('Visits').find(v=>v.id===id||v.syncId===syncId);if(old&&old.status!=='Draft')return {id:old.id,status:old.status,cloudSynced:true,duplicate:true};if(old&&old.engineerEmail!==u.email)throw Error('Cannot modify another engineer visit');const ts=now_(),status=p.final?'Pending Client':'Draft';const v={id:old?old.id:id,storeCode:store.code,zone:store.zone,visitType:p.visitType,engineerEmail:u.email,engineerName:u.name,createdAt:old?old.createdAt:ts,updatedAt:ts,status,remarks:safe_(p.remarks,5000),damaged:p.damaged?'Yes':'No',damageNote:safe_(p.damageNote,3000),clientTokenHash:old?old.clientTokenHash:'',clientExpiresAt:old?old.clientExpiresAt:'',clientName:'',clientStars:'',clientFeedback:'',clientDecidedAt:'',emails:JSON.stringify((p.emails||[]).slice(0,3)),phones:JSON.stringify((p.phones||[]).slice(0,3)),revision:String(Number(old?.revision||0)+1),syncId,ticketId:old?.ticketId||'',ticketStatus:old?.ticketStatus||''};if(old)update_('Visits',old.__row,v);else append_('Visits',[v]);
 // Replace detail rows for draft edits; new IDs prevent collisions.
 const devices=p.devices.map(d=>({id:uid_(),visitId:v.id,type:d.type,subtype:safe_(d.subtype,80),serial:safe_(d.serial,120),ip:safe_(d.ip,50),rposIp:safe_(d.rposIp,50),mac:safe_(d.mac,80),imei:safe_(d.imei,80),amc:amcLookup_(d.serial)?'Yes':'No',activity:safe_(d.activity,3000),remarks:safe_(d.remarks,3000),imageIds:JSON.stringify(d.imageIds||[])}));
 // Old detail rows remain for audit if draft edited; use latest IDs only via revision mapping in Devices.
 if(old){const ds=all_('Devices').filter(d=>d.visitId===v.id);const oldIds=new Set(ds.map(d=>d.id));all_('Spares').filter(x=>x.visitId===v.id&&oldIds.has(x.deviceId)).sort((a,b)=>b.__row-a.__row).forEach(x=>sheet_('Spares').deleteRow(x.__row));ds.sort((a,b)=>b.__row-a.__row).forEach(d=>sheet_('Devices').deleteRow(d.__row));}
 append_('Devices',devices);append_('Spares',devices.flatMap((d,i)=>(p.devices[i].spares||[]).map(sp=>({id:uid_(),visitId:v.id,deviceId:d.id,name:safe_(sp.name,100),otherText:safe_(sp.otherText,300)}))));audit_(u.email,'VISIT_'+(p.final?'SUBMITTED':'DRAFT'),v.id,{devices:devices.length});if(p.final&&u.role==='Engineer'&&!store.assignedEngineer){store.assignedEngineer=u.email;update_('Stores',store.__row,store);}if(p.final){notify_(store.zone,'PM submitted for customer approval',v.id,`PM visit ${v.id} submitted at ${store.code} by ${u.name}.`);}if(p.damaged){notify_(store.zone,'Device damaged / Pune HO',v.id,`Device damaged at ${store.code}. Engineer ${u.name}. ${v.damageNote}`);tryCreateVtiger_(v);}return {id:v.id,status,cloudSynced:true,deviceCount:devices.length};}finally{lock.releaseLock();}}
function getVisit_(u,id){const v=findBy_('Visits','id',id);if(!v)throw Error('Visit not found');if(u.role==='Engineer'&&v.engineerEmail!==u.email)throw Error('Access denied');authorize_(u,v.zone);return detail_(v);}
function detail_(v){const d=all_('Devices').filter(x=>x.visitId===v.id);const sp=all_('Spares').filter(x=>x.visitId===v.id);return {...summary_(v),devices:d.map(({__row,...x})=>({...x,spares:sp.filter(s=>s.deviceId===x.id).map(({__row,...s})=>s)}))};}
function uploadImage_(u,p){if(!p.data||!/^image\/(jpeg|png|webp)$/.test(p.mime))throw Error('Only JPEG/PNG/WebP images');const raw=Utilities.base64Decode(p.data);if(raw.length>1200000)throw Error('Image exceeds 1.2MB compressed limit');const folderId=cfg_('DRIVE_FOLDER_ID');if(!folderId)throw Error('DRIVE_FOLDER_ID not configured');const f=DriveApp.getFolderById(folderId).createFile(Utilities.newBlob(raw,p.mime,'PM-'+uid_()+'.jpg'));audit_(u.email,'IMAGE_UPLOADED',f.getId(),{});return {id:f.getId()};}
function newApprovalLink_(u,p){const v=findBy_('Visits','id',p.id);if(!v||v.status!=='Pending Client')throw Error('Visit not ready for approval');if(u.role==='Engineer'&&v.engineerEmail!==u.email)throw Error('Access denied');authorize_(u,v.zone);const token=Utilities.getUuid()+Utilities.getUuid(),expires=new Date(Date.now()+30*60*1000).toISOString();v.clientTokenHash=tokenHash_(token);v.clientExpiresAt=expires;update_('Visits',v.__row,v);const base=cfg_('PUBLIC_PORTAL_URL')||ScriptApp.getService().getUrl();return {url:base.replace(/\/$/,'')+'/approve/'+encodeURIComponent(token),expiresAt:expires};}
function clientFind_(token){if(!token||token.length>200)throw Error('Invalid approval link');const hash=tokenHash_(token);const v=findBy_('Visits','clientTokenHash',hash);if(!v||new Date(v.clientExpiresAt).getTime()<Date.now())throw Error('Approval link expired or invalid');return v;}
function clientRead_(token){const v=clientFind_(token);return detail_(v);}
function clientDecision_(p){const lock=LockService.getScriptLock();lock.waitLock(20000);try{const v=clientFind_(p.token);if(v.status!=='Pending Client')throw Error('Decision already recorded');if(!['approve','reject'].includes(p.decision))throw Error('Select approve/reject');v.status=p.decision==='approve'?'Completed':'Rejected';v.clientName=safe_(p.name,120);if(!v.clientName)throw Error('Customer name required');v.clientStars=String(Math.max(1,Math.min(5,Number(p.stars)||1)));v.clientFeedback=safe_(p.feedback,2000);v.clientDecidedAt=now_();v.updatedAt=v.clientDecidedAt;v.clientTokenHash='';update_('Visits',v.__row,v);audit_('Customer:'+v.clientName,'CLIENT_'+v.status.toUpperCase(),v.id,{stars:v.clientStars});if(v.status==='Rejected')notify_(v.zone,'Client rejected PM',v.id,`Client rejected PM ${v.id} at store ${v.storeCode}. ${v.clientFeedback}`);else notify_(v.zone,'PM completed and approved',v.id,`Customer ${v.clientName} approved PM ${v.id} for store ${v.storeCode}. Rating: ${v.clientStars}/5.`);return {id:v.id,status:v.status};}finally{lock.releaseLock();}}
function tryCreateVtiger_(v){const url=cfg_('VTIGER_WEBHOOK_URL'),secret=cfg_('VTIGER_WEBHOOK_SECRET');if(!url||!secret)return;try{const resp=UrlFetchApp.fetch(url,{method:'post',contentType:'application/json',headers:{'X-ITEK-Secret':secret},payload:JSON.stringify({event:'damage',visitId:v.id,subject:`${v.storeCode} PM Visit ${v.zone} on ${v.createdAt.slice(0,10)}`,note:v.damageNote}),muteHttpExceptions:true});if(resp.getResponseCode()>=300)throw Error('Vtiger connector HTTP '+resp.getResponseCode());}catch(e){console.error('Vtiger integration failed '+e);}}

// Vercel bridge: API returns JSON; employee authorization remains in api().
function doPost(e){try{const request=JSON.parse(e.postData.contents||'{}');if(!/^[a-zA-Z]+$/.test(request.action||''))throw Error('Invalid action');const result=api(request.token||'',request.action,request.payload||{});return ContentService.createTextOutput(JSON.stringify({ok:true,data:result})).setMimeType(ContentService.MimeType.JSON);}catch(err){return ContentService.createTextOutput(JSON.stringify({ok:false,error:String(err.message||err),errorId:'ITEK-SHEETS-'+Utilities.getUuid().slice(0,8).toUpperCase(),category:'SHEETS',remark:'Google Sheets backend request failed'})).setMimeType(ContentService.MimeType.JSON);}}
